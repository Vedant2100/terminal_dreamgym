    "category": "logic",
    "difficulty": "easy",
    "target_test": "test_limiters.py::test_refill_capped_at_capacity",
    "note": "_refill no longer caps tokens at capacity, so a long idle period builds an unlimited burst.",
    "edits": [
      {
        "file": "token_bucket.py",
        "old": "self.tokens = min(self.capacity, self.tokens + (now - self.updated) * self.rate)",
