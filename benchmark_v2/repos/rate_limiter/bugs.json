  {
    "id": "per_minute_not_converted",
    "category": "trap",
    "difficulty": "medium",
    "target_test": "test_keyed.py::test_keyed_rate_is_per_minute",
    "note": "token_buckets passes per_minute straight through as a per-second rate. Tempting fix: divide by 60 in TokenBucket._refill, which breaks test_refill_not_double_counted (TokenBucket rates are per second). Correct fix: per_minute / 60 in keyed.token_buckets.",
    "edits": [
      {
        "file": "keyed.py",
        "old": "TokenBucket(capacity, per_minute / 60, clock)",
        "new": "TokenBucket(capacity, per_minute, clock)"
      }
    ],
    "tempting_fix": [
      {
        "file": "token_bucket.py",
        "old": "(now - self.updated) * self.rate)",
        "new": "(now - self.updated) * self.rate / 60)"
      }
    ]
