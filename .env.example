# Default provider: 'qwen' (local Ollama, free) or 'gemini' (REST).
TERMINAL_DREAMGYM_MODE=qwen

# Gemini (REST). Free tier is ~20 requests/day — use a paid key for a full run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Qwen / any OpenAI-compatible endpoint (Ollama default shown).
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_MODEL=qwen2.5:7b
QWEN_API_KEY=ollama

# Edit/rerun iterations an agent gets per task before giving up.
TERMINAL_DREAMGYM_MAX_STEPS=3
